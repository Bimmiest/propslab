{
  // The options every project here shares. Each project sets its own target,
  // lib, types and build-info file, which differ on purpose (see
  // tsconfig.engine.json). packages/mcp-server has its own install and keeps
  // its own copy.
  "compilerOptions": {
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
    /* `exactOptionalPropertyTypes` is off on purpose, in every tsconfig. Tried
       (#510): 38 sites in 27 files across the app, the engine, the MCP server's
       zod output schemas, the e2e specs and vitest.stryker.config.ts (whose
       typing is a third party's). Most are the same fix, a `key: T | undefined`
       assigned to an optional `key?: T`, but 13 are in ten src/engine files,
       which the PR mutation check would then have to re-run in full, and the
       zod ones need their schemas retyped. That is a change to make by itself:
       turn the flag on here and in packages/mcp-server/tsconfig.json, and fix
       what `npm run typecheck` reports in both. */
  }
}

{
  // The worker entry points: engine rules plus the worker global scope, which
  // is what they actually run in. Checking them against DOM, as the app
  // project does, typed `self` as a Window.
  "extends": "./tsconfig.engine.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ES2022", "WebWorker"]
  },
  "include": ["src/engine/*Worker.ts"],
  "exclude": []
}

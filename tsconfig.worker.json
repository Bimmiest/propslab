{
  // The worker entry points, against the worker global scope, which is what
  // they actually run in. Checking them against DOM, as the app project does,
  // typed `self` as a Window. No ambient packages: @types/node would admit
  // Buffer and process.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "types": []
  },
  "include": ["src/workers/*Worker.ts"]
}

# Refuse to install on a Node older than `engines` in package.json
# (propslab-ent #1600). Without it npm only warns, and the first real error on
# an old Node arrives minutes into setup from whichever tool trips first. The
# floor itself lives in `engines` and `.nvmrc`; this only makes npm hold to it.
#
# `devEngines` in package.json (#861) stops npm on a wrong Node before it
# resolves the tree, so the error names Node and not a peer dependency. This
# setting stays: it also covers an npm older than 10.9.0, which ignores
# `devEngines`.
#
# It applies to every dependency's `engines` too, so a package that declares a
# range this repository's Node falls outside of fails `npm ci` rather than
# installing and failing later.
engine-strict=true

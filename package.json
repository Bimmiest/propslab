{
  "name": "propslab",
  "private": true,
  "version": "1.3.0",
  "description": "Browser-based simulator for Splunk's props.conf and transforms.conf processing pipeline.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bimmiest/propslab.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,mts}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:mutation": "stryker run",
    "test:mutation:canary": "stryker run --mutate src/engine/utils/wildcardMatch.ts --reporters json && node scripts/check-mutation-canary.mjs",
    "check:overrides": "node scripts/check-radix-overrides.mjs"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "monaco-editor": "^0.57.0",
    "pcre2-wasm-utf16": "github:Bimmiest/pcre2-wasm-utf16#e3b48c1087bf70410fc4cb0d65c2ec4bbbf5850b",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "marked": "14.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@radix-ui/react-compose-refs": "1.1.5",
    "@radix-ui/react-context": "1.3.0",
    "@radix-ui/react-dismissable-layer": "1.2.1",
    "@radix-ui/react-focus-guards": "1.2.0",
    "@radix-ui/react-focus-scope": "1.3.1",
    "@radix-ui/react-id": "1.1.4",
    "@radix-ui/react-portal": "1.2.0",
    "@radix-ui/react-presence": "1.1.11",
    "@radix-ui/react-primitive": "2.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-use-callback-ref": "1.1.5",
    "@radix-ui/react-use-controllable-state": "1.3.0",
    "@radix-ui/react-use-effect-event": "0.0.5",
    "@radix-ui/react-use-layout-effect": "1.1.4",
    "typed-rest-client": {
      "qs": "^6.16.0"
    },
    "monaco-editor": {
      "dompurify": "^3.4.17"
    }
  }
}

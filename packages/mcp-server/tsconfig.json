{
  "compilerOptions": {
    // Type-check only — esbuild does the emit (see package.json "build").
    // `bundler` resolution matches how the app compiles the engine sources,
    // which keeps this package from imposing extension rules on them.
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // No DOM: this runs under Node, and so does the engine it bundles. The DOM
    // lib used to be here because kvMode.ts called DOMParser, which let that
    // call type-check and then extract nothing at run time (#280).
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noEmit": true,
    "esModuleInterop": true,
    // server.ts imports its version from package.json (#319), which esbuild
    // inlines at build time.
    "resolveJsonModule": true,
    // A file outside this package (the shared test builders in ../../src/test)
    // that imports `pcre2-wasm-utf16` or `propslab-engine` would otherwise
    // resolve it from its own directory, i.e. the repository root's
    // node_modules, which CI does not install for this package. This package
    // declares both itself, so its copies are the ones checked (and the build
    // aliases the regex engine the same way). The target is the package's
    // `exports["."]`, which a path mapping does not read on its own.
    "paths": {
      "pcre2-wasm-utf16": ["./node_modules/pcre2-wasm-utf16/src/index.ts"],
      "propslab-engine": ["./node_modules/propslab-engine/src/index.ts"]
    },
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}

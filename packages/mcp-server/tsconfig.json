{
  "compilerOptions": {
    // Type-check only — esbuild does the emit (see package.json "build").
    // `bundler` resolution matches how the app compiles the engine sources,
    // which keeps this package from imposing extension rules on them.
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // No DOM: this runs under Node, and so does the engine it bundles. The DOM
    // lib used to be here because kvMode.ts called DOMParser, which let that
    // call type-check and then extract nothing at run time (#280).
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    // server.ts imports its version from package.json (#319), which esbuild
    // inlines at build time.
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}

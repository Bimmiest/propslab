{
  "name": "propslab-mcp",
  "private": true,
  "version": "0.1.0",
  "description": "MCP server over the propslab simulation engine: simulate, validate, explain_precedence, lookup_directive.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "propslab-mcp": "dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && npm run build:index && npm run build:worker",
    "build:index": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist --sourcemap --banner:js=\"#!/usr/bin/env node\"",
    "build:worker": "esbuild src/simulateWorker.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist --sourcemap",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}

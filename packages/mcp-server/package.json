{
  "name": "propslab-mcp",
  "private": true,
  "version": "0.1.0",
  "description": "MCP server over the propslab simulation engine: simulate, validate, explain_precedence, lookup_directive.",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "propslab-mcp": "dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && npm run build:index && npm run build:worker && npm run build:regex-engine",
    "build:index": "esbuild src/index.ts --bundle --platform=node --target=node26 --format=cjs --outdir=dist --sourcemap --alias:pcre2-wasm-utf16=pcre2-wasm-utf16 --banner:js=\"#!/usr/bin/env node\"",
    "build:worker": "esbuild src/simulateWorker.ts --bundle --platform=node --target=node26 --format=cjs --outdir=dist --sourcemap --alias:pcre2-wasm-utf16=pcre2-wasm-utf16",
    "build:regex-engine": "node ../../scripts/check-wasm-checksum.mjs && node -e \"require('node:fs').copyFileSync(require.resolve('pcre2-wasm-utf16/pcre2.wasm'), 'dist/pcre2.wasm')\"",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "pcre2-wasm-utf16": "github:Bimmiest/pcre2-wasm-utf16#8651a3023bf1f0a683f67203adce2c73a33f03e6",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
